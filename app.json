{
  "expo": {
    "name": "دفتر الدين",
    "slug": "daftar-al-dayn",
    "scheme": "daftar",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daftaraldayn.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "لفتح دفتر الدين بالبصمة أو الوجه"
      }
    },
    "android": {
      "package": "com.daftaraldayn.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c0f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "لفتح دفتر الدين بالبصمة أو الوجه"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0b0c0f",
          "dark": {
            "backgroundColor": "#0b0c0f"
          }
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
